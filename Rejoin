--================ Logic ================--
local remaining = settings.minutes * 60
local rejoining = false
local failCount = 0

local function setStatus(t) statusLabel.Text = t end

local function fmt(s)
    s = math.max(0, math.floor(s))
    local h = math.floor(s / 3600)
    local m = math.floor((s % 3600) / 60)
    local sec = s % 60
    if h > 0 then return string.format("%d:%02d:%02d", h, m, sec) end
    return string.format("%02d:%02d", m, sec)
end

local function refresh()
    toggleBtn.Text = "Timer: " .. (settings.enabled and "ON" or "OFF")
    toggleBtn.BackgroundColor3 = settings.enabled
        and Color3.fromRGB(50, 160, 80) or Color3.fromRGB(180, 50, 50)
    kickBtn.Text = "Rejoin Menu on Kick: " .. (settings.onKick and "ON" or "OFF")
    afkBtn.Text = "Anti-AFK: " .. (settings.antiAfk and "ON" or "OFF")
    infoLabel.Text = "Place: " .. game.PlaceId .. "  |  Menu: " .. settings.menuId
    timerLabel.Text = inMenu() and "MENU" or fmt(remaining)
end

local function goMenu(reason)
    if rejoining then return end
    rejoining = true
    setStatus((reason or "Rejoining") .. " - going to main menu...")
    local ok, err = pcall(function()
        TeleportService:Teleport(settings.menuId, player)
    end)
    if not ok then
        rejoining = false
        setStatus("Error: " .. tostring(err))
    end
end

TeleportService.TeleportInitFailed:Connect(function(plr, result, err)
    if plr ~= player then return end
    rejoining = false
    failCount += 1
    if failCount > 10 then
        failCount = 0
        remaining = settings.minutes * 60
        setStatus("Gave up after 10 tries. Timer reset.")
        return
    end
    setStatus("Failed (" .. tostring(result) .. ") - retry " .. failCount .. "/10")
    task.wait(3)
    goMenu("Retrying")
end)

-- Rejoin menu when kicked / disconnected
GuiService.ErrorMessageChanged:Connect(function(msg)
    if settings.onKick and msg ~= "" and not rejoining then
        task.wait(2)
        goMenu("Disconnected")
    end
end)

-- Anti-AFK
