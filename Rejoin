        VirtualUser:CaptureController()
        VirtualUser:ClickButton2(Vector2.new())
    end
end)

--================ Buttons ================--
toggleBtn.MouseButton1Click:Connect(function()
    settings.enabled = not settings.enabled
    if settings.enabled and remaining <= 0 then remaining = settings.minutes * 60 end
    save(); refresh()
end)

kickBtn.MouseButton1Click:Connect(function()
    settings.onKick = not settings.onKick
    save(); refresh()
end)

afkBtn.MouseButton1Click:Connect(function()
    settings.antiAfk = not settings.antiAfk
    save(); refresh()
end)

setMenuBtn.MouseButton1Click:Connect(function()
    settings.menuId = game.PlaceId
    save(); refresh()
    setStatus("Menu set to this place (" .. game.PlaceId .. ")")
end)

nowBtn.MouseButton1Click:Connect(function()
    goMenu("Manual")
end)

intervalBox.FocusLost:Connect(function()
    local n = tonumber(intervalBox.Text)
    if n then
        settings.minutes = math.clamp(math.floor(n), 1, 1440)
        remaining = settings.minutes * 60
        save(); refresh()
        setStatus("Interval set to " .. settings.minutes .. " min")
    end
    intervalBox.Text = tostring(settings.minutes)
end)

local minimized = false
minBtn.MouseButton1Click:Connect(function()
    minimized = not minimized
    content.Visible = not minimized
    main.Size = minimized and UDim2.new(0, 250, 0, 32) or UDim2.new(0, 250, 0, FULL_H)
    minBtn.Text = minimized and "+" or "-"
end)

-- Dragging (mouse + touch)
local dragging, dragStart, startPos
titleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = main.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then dragging = false end
        end)
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch) then
        local d = input.Position - dragStart
        main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X,
            startPos.Y.Scale, startPos.Y.Offset + d.Y)
    end
end)

